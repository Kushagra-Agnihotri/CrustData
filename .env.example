# Copy to .env (never commit .env)
RUN_DATE=2026-11-22
RUN_TIME_LIMIT_S=900
RUN_CREDIT_LIMIT=200
COST_OF_CASH=0.12

# Sources: mock (offline fixtures) | live
CRUSTDATA_MODE=mock
IFSC_MODE=mock
CRUSTDATA_API_KEY=
CRUSTDATA_INR_PER_CREDIT=1.0

# Optional: Gemini extraction (without a key, the deterministic parser is used)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Payments: mock | razorpayx (TEST keys only: rzp_test_...)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Postgres/Supabase (planned swap for the SQLite mock DB — see app/db.py)
SUPABASE_DB_URL=
