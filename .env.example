# Copy to .env (never commit .env)
RUN_DATE=2026-11-22
RUN_TIME_LIMIT_S=900
RUN_CREDIT_LIMIT=200
COST_OF_CASH=0.12

# Sources: replay (real responses recorded in data/live_recordings.json, no key needed)
#        | live (call the APIs and append to the recordings) | mock (offline synthetic fixtures)
CRUSTDATA_MODE=replay
IFSC_MODE=replay
# Needed only for CRUSTDATA_MODE=live and scripts/record_live.py. Never commit a real key.
CRUSTDATA_API_KEY=
CRUSTDATA_INR_PER_CREDIT=1.0

# Optional: Gemini extraction (deterministic parser is the fallback on any error, and the default without a key)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Payments: mock | razorpayx (TEST keys only: rzp_test_...)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Postgres/Supabase (planned swap for the SQLite mock DB — see app/db.py)
SUPABASE_DB_URL=
