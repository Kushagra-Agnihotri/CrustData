{
  "case01": {
    "decision": "PAY_ELIGIBLE",
    "tier": 2,
    "label": "Clean invoice, PO matches (large vendor, low priority)"
  },
  "case02": {
    "decision": "PAY_ELIGIBLE",
    "tier": 0,
    "label": "Clean invoice via email; critical supplier overdue"
  },
  "case03": {
    "decision": "PAY_ELIGIBLE",
    "tier": 2,
    "label": "Clean invoice; MSME trader (45-day rule n/a)"
  },
  "case04": {
    "decision": "PAY_ELIGIBLE",
    "tier": 2,
    "label": "Clean invoice; MSME small, deadline not near"
  },
  "case05": {
    "decision": "HOLD",
    "must_include": [
      "DUPLICATE_INVOICE"
    ],
    "first": "DUPLICATE_INVOICE",
    "label": "Re-issue of #2 as INV/42 vs INV-0042"
  },
  "case06": {
    "decision": "HOLD",
    "must_include": [
      "POSSIBLE_DUPLICATE"
    ],
    "label": "Same vendor + amount, new number, 3 days later"
  },
  "case07": {
    "decision": "BLOCK",
    "must_include": [
      "BANK_CHANGE_FRAUD",
      "SENDER_DOMAIN_MISMATCH",
      "SENDER_NOT_VERIFIED_AT_VENDOR"
    ],
    "label": "Polite bank-change email from lookalike domain"
  },
  "case08": {
    "decision": "HOLD",
    "must_include": [
      "VENDOR_NOT_APPROVED"
    ],
    "label": "Homoglyph lookalike vendor, different GSTIN"
  },
  "case09": {
    "decision": "HOLD",
    "must_include": [
      "OVER_BILLED"
    ],
    "label": "Billed qty 120 > PO qty 100"
  },
  "case10": {
    "decision": "BLOCK",
    "must_include": [
      "INVALID_GSTIN"
    ],
    "label": "GSTIN fails checksum"
  },
  "case11": {
    "decision": "HOLD",
    "must_include": [
      "UNVERIFIABLE_VENDOR"
    ],
    "label": "Sharma Traders: no GSTIN, no PO \u2192 I can't verify"
  },
  "case12": {
    "decision": "HOLD",
    "must_include": [
      "SOURCE_UNAVAILABLE"
    ],
    "only": true,
    "inject_fault": [
      "crustdata",
      "ifsc"
    ],
    "label": "Crustdata + IFSC timeout injected"
  },
  "case13": {
    "decision": "PAY_ELIGIBLE",
    "tier": 0,
    "paid_in_full": true,
    "label": "MSME micro, accepted 40 days ago \u2192 Tier 0"
  },
  "case14": {
    "decision": "PAY_ELIGIBLE",
    "tier": 1,
    "paid_in_full": true,
    "label": "2/10 net 30 within discount window \u2192 Tier 1"
  },
  "case15": {
    "decision": "PAY_ELIGIBLE",
    "tier": 2,
    "split": true,
    "label": "Large invoice, cash short \u2192 instalments"
  },
  "case16": {
    "decision_same_as": "case01",
    "isolated": true,
    "label": "Case 1 re-worded + re-laid-out"
  },
  "case17": {
    "crash_test": true,
    "label": "kill -9 mid-payment, restart \u2192 each instalment paid once"
  },
  "case19": {
    "decision": "HOLD",
    "must_include": [
      "BANK_CHANGE_REQUEST"
    ],
    "must_not_include": [
      "BANK_CHANGE_FRAUD",
      "SENDER_DOMAIN_MISMATCH",
      "REPLY_TO_MISMATCH",
      "PRESSURE_LANGUAGE"
    ],
    "pending_account": true,
    "label": "Genuine bank change from the vendor's own domain \u2192 HOLD, not BLOCK"
  },
  "case20": {
    "decision": "PAY_ELIGIBLE",
    "must_include_ok": [
      "BANK_MATCHES_MASTER"
    ],
    "bank_change_flow": "name_match",
    "label": "After docs + call-back + penny drop + 2nd approver: pays to new account"
  },
  "case20b": {
    "bank_change_flow": "name_mismatch",
    "label": "Penny drop returns a different holder \u2192 approval refused"
  }
}